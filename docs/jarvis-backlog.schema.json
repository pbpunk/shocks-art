{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis-backlog.schema.json",
  "title": "JARVIS App Backlog",
  "description": "Machine-readable app-owned roadmap consumed by JARVIS after the operational contract is established.",
  "type": "object",
  "required": ["schemaVersion", "id", "appId", "name", "status", "phases", "milestones", "items"],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "minLength": 1},
    "appId": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "repository": {"type": "string"},
    "status": {"enum": ["planned", "active", "paused", "complete", "archived"]},
    "authoritative": {"type": "boolean"},
    "updatedAt": {"type": "string"},
    "goal": {"type": "string"},
    "executionLegend": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "knowns": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "unknowns": {
      "type": "array",
      "items": {"$ref": "#/$defs/unknown"}
    },
    "phases": {
      "type": "array",
      "items": {"$ref": "#/$defs/phase"}
    },
    "milestones": {
      "type": "array",
      "items": {"$ref": "#/$defs/milestone"}
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["id", "title", "detail"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": true
    },
    "unknown": {
      "type": "object",
      "required": ["id", "title", "detail"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "detail": {"type": "string"},
        "resolutionItems": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "phase": {
      "type": "object",
      "required": ["id", "order", "name", "goal"],
      "properties": {
        "id": {"type": "string"},
        "order": {"type": "integer", "minimum": 0},
        "name": {"type": "string"},
        "goal": {"type": "string"},
        "milestone": {"type": "string"}
      },
      "additionalProperties": true
    },
    "milestone": {
      "type": "object",
      "required": ["id", "name", "acceptance"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "acceptance": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["id", "phase", "title", "status", "execution", "priority", "required", "dependsOn", "acceptance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["todo", "in_progress", "blocked", "done", "deferred"]},
        "execution": {"enum": ["github", "codex", "both"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "required": {"type": "boolean"},
        "dependsOn": {
          "type": "array",
          "items": {"type": "string"}
        },
        "acceptance": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
