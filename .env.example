DATABASE_URL=sqlite:///./data/shocks_art.db
LIBRARY_INGEST_PATH=./data/library_inbox
LIBRARY_INDEX_PATH=./data/library_index
LIBRARY_SCRATCH_PATH=./data/library_scratch
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=shocksart
YOUTUBE_OAUTH_CLIENT_SECRETS_FILE=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/analytics/oauth2callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_ANALYTICS_BACKFILL_START=2026-06-01
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PROMPT_VERSION=1.0
SCHEMA_VERSION=1.0
MAX_RETRIES=2
PROCESSING_CONCURRENCY=1
CANDIDATES_PER_STREAM=3

# Shock's Art GPT Bridge. The production Sheet is pinned by start_host_worker.ps1 so
# the first JARVIS dashboard update can bootstrap the bridge without local .env edits.
# Override this only when intentionally targeting a different bridge.
SHOCKS_GOOGLE_SPREADSHEET_ID=1hD8IqH_o1RJnVyxpAuhSmR-nB6DNwvK51xZIyn8IX_I
SHOCKS_GOOGLE_CREDENTIALS=F:\\JARVIS-secrets\\pancake-google-service-account.json
SHOCKS_GOOGLE_HOST_POLL_SECONDS=15
SHOCKS_GOOGLE_HOST_TIMEOUT_SECONDS=21600
SHOCKS_GOOGLE_UPDATE_POLL_SECONDS=15
SHOCKS_GOOGLE_UPDATE_JOURNAL_PATH=./data/google_update_journal.json
SHOCKS_GOOGLE_UPDATE_STATUS_PATH=./data/google_update_worker_status.json
SHOCKS_GOOGLE_UPDATE_RECEIPT_DIR=./data/google_update_receipts

# Fixed host profile inputs. These are trusted workstation settings, not Sheet fields.
SHOCKS_WHISPER_PYTHON=
SHOCKS_WHISPER_BENCHMARK_MANIFEST=
SHOCKS_PRIVATE_YOUTUBE_TEST_URL=
SHOCKS_YTDLP_COOKIES_FROM_BROWSER=chrome
SHOCKS_INDEXER_SOAK_SECONDS=900
SHOCKS_INDEXER_SOAK_RESTART=0
